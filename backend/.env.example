# AgriDirect Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real credentials.

APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./marketplace_dev.db

JWT_SECRET_KEY=

OTP_PROVIDER_MODE=smtp

KYC_PROVIDER_MODE=mock

PAYMENT_PROVIDER_MODE=mock
PAYMENT_MOCK_MODE=success

NOTIFICATION_PROVIDER_MODE=mock
DELIVERY_PROVIDER_MODE=mock

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_SENDER_EMAIL=

# AI Assistant (Gemini)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash
GEMINI_VOICE=Kore

# External Search (Tavily)
TAVILY_API_KEY=

# Weather (OpenWeather)
OPENWEATHER_API_KEY=

# AgriDirect API base URL
AGRIDIRECT_API_URL=http://127.0.0.1:8000

# WhatsApp (future — leave blank until provider configured)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# Telephony (future — leave blank until provider configured)
TELEPHONY_PROVIDER_KEY=
