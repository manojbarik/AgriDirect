# Docker Compose environment template.
# Copy to .env and edit:  cp .docker.env.example .env
# Compose reads .env automatically for ${VAR} interpolation.
# NEVER commit a real .env file (it is gitignored).

# ---------------------------------------------------------------------------
# Environment mode
#   development (default, safe for local) | production | test
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (used ONLY when running behind a reverse proxy, not through compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace

# ---------------------------------------------------------------------------
# Backend secrets & tokens
# ---------------------------------------------------------------------------
# PRODUCTION: set APP_ENV=production and provide a strong random JWT secret
# (e.g. `openssl rand -hex 32`). The app refuses to start in non-development
# environments when this is empty or a known-insecure default.
JWT_SECRET_KEY=dev-insecure-secret-change-me-000000000000
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------------------
# CORS / networking
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080
BACKEND_PORT=8000
# Empty = same-origin API calls through the Nginx proxy
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Provider modes — all MOCK by default. Real payment/OTP/KYC/delivery require
# an explicit provider selection AND credentials; never enable without them.
# ---------------------------------------------------------------------------
OTP_PROVIDER_MODE=mock
KYC_PROVIDER_MODE=mock
PAYMENT_PROVIDER_MODE=mock
PAYMENT_MOCK_MODE=success
NOTIFICATION_PROVIDER_MODE=mock
DELIVERY_PROVIDER_MODE=mock
# PRODUCTION: required to accept payment webhooks; a random strong secret.
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO