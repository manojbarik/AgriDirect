# Shared local configuration. Copy to .env and never commit the copy.

# Backend
APP_NAME=AI Farmer-Buyer Marketplace API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+psycopg://marketplace:marketplace@localhost:5432/farmer_buyer_marketplace
# REQUIRED in any non-development environment: a strong random secret (>= 48 bytes).
# The app refuses to sign JWT tokens when this is unset/generic outside development.
JWT_SECRET_KEY=replace-with-a-local-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Set True only when the API sits behind a trusted reverse proxy (nginx etc.)
# so X-Forwarded-For is honoured for rate limiting and the refresh audit log.
TRUST_PROXY_HEADERS=false

# Mock modes are for development/tests only. In non-development environments
# the app logs warnings and the payment webhook refuses unauthenticated events,
# and PAYMENT_WEBHOOK_SECRET must be set to accept webhook callbacks.
OTP_PROVIDER_MODE=mock
# Email delivery via Gmail API (OAuth2). Set OTP_PROVIDER_MODE=gmail and
# provide the client credentials plus a refresh token obtained by running:
#   cd backend && python -m scripts.gmail_oauth_setup
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Email delivery via Gmail SMTP with an App Password (simplest option).
# Set OTP_PROVIDER_MODE=smtp and fill the three SMTP_* values below.
# Get an app password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the account).
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your-gmail-address@gmail.com
#SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
#SMTP_SENDER_EMAIL=your-gmail-address@gmail.com
KYC_PROVIDER_MODE=mock
PAYMENT_PROVIDER_MODE=mock
NOTIFICATION_PROVIDER_MODE=mock
DELIVERY_PROVIDER_MODE=mock
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
